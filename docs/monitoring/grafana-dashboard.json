{
  "title": "SwiftLinkAI Production Dashboard",
  "uid": "swiftlinkai-prod",
  "tags": ["swiftlinkai", "production"],
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Redirects / minute",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "rate(http_server_requests_seconds_count{uri='/api/v1/{alias}'}[1m]) * 60",
        "legendFormat": "req/min"
      }]
    },
    {
      "id": 2,
      "title": "P95 Redirect Latency (ms)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{uri='/api/v1/{alias}'}[5m])) * 1000",
        "legendFormat": "p95 ms"
      }]
    },
    {
      "id": 3,
      "title": "Redis Cache Hit Ratio",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total)",
        "legendFormat": "hit ratio"
      }],
      "options": { "minValue": 0, "maxValue": 1 }
    },
    {
      "id": 4,
      "title": "Circuit Breaker State (AI)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "resilience4j_circuitbreaker_state{name='aiService'}",
        "legendFormat": "{{state}}"
      }]
    },
    {
      "id": 5,
      "title": "HTTP Request Rate by Status",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count{status='200'}[1m])", "legendFormat": "2xx" },
        { "expr": "rate(http_server_requests_seconds_count{status=~'4..'}[1m])", "legendFormat": "4xx" },
        { "expr": "rate(http_server_requests_seconds_count{status=~'5..'}[1m])", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 6,
      "title": "JVM Heap Usage",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "jvm_memory_used_bytes{area='heap'}",
        "legendFormat": "Heap Used"
      }]
    },
    {
      "id": 7,
      "title": "URLs Shortened (total)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 },
      "targets": [{
        "expr": "increase(url_shortened_total[24h])",
        "legendFormat": "today"
      }]
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser"
}
