# NOTE: Do NOT commit real secrets. Use Sealed Secrets, AWS Secrets Manager, or Vault.
# This is a template only — values must be base64 encoded.
apiVersion: v1
kind: Secret
metadata:
  name: swiftlinkai-secrets
  namespace: swiftlinkai
type: Opaque
data:
  db-url: <base64_encoded_jdbc_url>
  db-username: <base64_encoded_username>
  db-password: <base64_encoded_password>
  openai-api-key: <base64_encoded_openai_key>
  jwt-secret: <base64_encoded_jwt_secret>
